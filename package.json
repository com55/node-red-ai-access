{
  "name": "@com55/node-red-ai-access",
  "version": "0.1.1",
  "description": "Node-RED plugin that gives AI agents temporary, owner-approved access via REST and MCP",
  "main": "dist/plugin.cjs",
  "types": "dist/plugin.d.cts",
  "type": "module",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      },
      "default": "./dist/plugin.cjs"
    },
    "./plugin": {
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      },
      "default": "./dist/plugin.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "docs",
    "ai-access.cjs",
    "ai-access.html",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "node-red": {
    "version": ">=4.0.0",
    "plugins": {
      "ai-access": "ai-access.cjs"
    }
  },
  "peerDependencies": {
    "node-red": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "node-red": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "build:prod": "NODE_ENV=production tsup",
    "dev:build": "NODE_ENV=development tsup --watch",
    "clean": "rimraf dist",
    "prebuild": "yarn clean",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "yarn type-check && yarn lint && yarn format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --open",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --ui --coverage --open",
    "generate:mcp-tools": "UPDATE_MCP_TOOLS=1 vitest run test/plugin/mcp-tools-doc.test.ts",
    "check:mcp-tools": "vitest run test/plugin/mcp-tools-doc.test.ts",
    "generate:errors": "UPDATE_ERRORS=1 vitest run test/plugin/error-registry.test.ts",
    "check:errors": "vitest run test/plugin/error-registry.test.ts",
    "prepare": "husky",
    "prepublishOnly": "yarn quality && yarn test && yarn build:prod"
  },
  "keywords": [
    "node-red",
    "node-red-plugin",
    "mcp",
    "model-context-protocol",
    "ai",
    "ai-agent",
    "llm",
    "automation"
  ],
  "author": "com55",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.5.2",
    "yaml": "^2.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "node-red": "4.1.12",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/com55/node-red-ai-access.git"
  },
  "bugs": {
    "url": "https://github.com/com55/node-red-ai-access/issues"
  },
  "homepage": "https://github.com/com55/node-red-ai-access#readme",
  "packageManager": "yarn@4.9.4+sha512.7b1cb0b62abba6a537b3a2ce00811a843bea02bcf53138581a6ae5b1bf563f734872bd47de49ce32a9ca9dcaff995aa789577ffb16811da7c603dcf69e73750b",
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
